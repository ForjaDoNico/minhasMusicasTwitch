# --- Supabase (local: values printed by `pnpm supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL (used for EventSub callback, OAuth redirect and chat links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twitch app (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# random string (10-100 chars) used to sign EventSub webhooks
TWITCH_EVENTSUB_SECRET=
# Optional dedicated bot account. Leave empty to have the streamer's own account reply in chat.
TWITCH_BOT_USER_ID=
TWITCH_BOT_LOGIN=
# Log bot replies instead of calling Helix (local development)
BOT_DRY_RUN=false

# Vercel Cron auth for /api/keepalive (Vercel sends it automatically when set)
CRON_SECRET=

# Local only: email/password login for seeded users at /dev/login (NEVER enable in production)
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
